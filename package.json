{
  "name": "llm-proxy",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r dotenv/config src/index.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Proxy that translates between LLM API formats (OpenAI, Gemini, Ollama, Anthropic) via a canonical intermediate format",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/generative-ai": "^0.24.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "msw": "^2.15.0",
    "nodemon": "^3.1.10",
    "ollama": "^0.6.4",
    "openai": "^7.30.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
