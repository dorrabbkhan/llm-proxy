#!/usr/bin/env bash
# git credential helper for conductor and Devin processes: answers "get"
# for github.com with a babelgate-conductor installation token. Wired up
# by app-env.sh through GIT_CONFIG_* environment variables.
set -euo pipefail
[ "${1:-}" = get ] || exit 0
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
host=""
while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = host ] && host="$v"; done
[ "$host" = github.com ] || exit 0
echo "username=x-access-token"
echo "password=$("$here/../app-token.sh")"
