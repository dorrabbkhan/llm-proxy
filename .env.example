PORT=3000

TARGET_API=

UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_RETRIES=1
MAX_BODY_SIZE=10mb

# Client-facing auth — when set, callers must send
# Authorization: Bearer <key>. Leave unset for local dev.
# PROXY_API_KEY=

OPENAI_API_KEY=
OPENAI_API_BASE_URL=

GEMINI_API_KEY=
GEMINI_API_BASE_URL=

OLLAMA_API_BASE_URL=http://localhost:11434

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=
# Longest gap allowed between upstream stream chunks (ms)
UPSTREAM_STREAM_IDLE_MS=300000
