{
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Edit(docs/conductor/**)",
      "Bash(scripts/conductor/*)",
      "Bash(./scripts/check.sh:*)",
      "Bash(scripts/llm-proxy-loop.sh:*)",
      "Bash(devin:*)",
      "Bash(npm ci)", "Bash(npm test:*)", "Bash(npm run typecheck)", "Bash(npm run build)",
      "Bash(gh pr view:*)", "Bash(gh pr diff:*)", "Bash(gh pr checks:*)", "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)", "Bash(gh run view:*)", "Bash(gh run list:*)", "Bash(gh run rerun:*)",
      "Bash(gh workflow run:*)", "Bash(gh api repos/*/issues/*/comments*)",
      "Bash(git fetch:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git switch:*)", "Bash(git worktree:*)", "Bash(git rev-parse:*)", "Bash(git pull:*)",
      "Bash(notify-send:*)", "Bash(mkdir:*)", "Bash(cat:*)", "Bash(grep:*)", "Bash(wc:*)", "Bash(sleep:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)", "Bash(gh pr review:*)", "Bash(gh release:*)", "Bash(gh api -X PUT*)",
      "Bash(git push:*)", "Bash(git commit:*)", "Bash(git reset:*)", "Bash(git tag:*)",
      "Bash(npm publish:*)", "Bash(npm run test:live:*)", "Bash(docker push:*)",
      "Bash(sudo:*)", "Bash(rm -rf:*)", "Bash(curl:*)", "Bash(wget:*)",
      "Edit(src/**)", "Edit(tests/**)", "Edit(package.json)", "Edit(package-lock.json)",
      "Edit(docs/decisions.md)", "Edit(.github/**)", "Edit(AGENTS.md)", "Edit(.devin/**)",
      "Edit(LICENSE)", "Edit(.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/conductor/session-env.sh",
            "statusMessage": "Acting as babelgate-conductor[bot]"
          }
        ]
      }
    ]
  }
}
