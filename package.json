{
  "name": "babelgate",
  "version": "1.1.0",
  "bin": {
    "babelgate": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r dotenv/config src/index.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "record:streams": "ts-node -r dotenv/config scripts/record-streams.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Dorrabb Khan",
  "license": "Apache-2.0",
  "description": "babelgate — proxy that translates between LLM API formats (OpenAI, Gemini, Ollama, Anthropic) via a canonical intermediate format",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/generative-ai": "^0.24.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "msw": "^2.15.0",
    "nodemon": "^3.1.10",
    "ollama": "^0.6.4",
    "openai": "^7.30.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dorrabbkhan/babelgate.git"
  },
  "bugs": "https://github.com/dorrabbkhan/babelgate/issues",
  "homepage": "https://github.com/dorrabbkhan/babelgate#readme"
}
